{
    "name": "scriptoshi/bitcoin-php",
    "description": "PHP Bitcoin library with functions for transactions, signatures, serialization, Random/Deterministic ECDSA keys, blocks, RPC bindings",
    "type": "library",
    "homepage": "https://github.com/scriptoshi/bitcoin-php",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Atif Nazir",
            "homepage": "https://github.com/scriptoshi",
            "role": "Author"
        }
    ],
    "autoload": {
        "psr-4": {
            "BitWasp\\Bitcoin\\": "src/"
        },
        "files": [
            "src/Script/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BitWasp\\Bitcoin\\Tests\\": "tests/"
        }
    },
    "require": {
        "php-64bit": ">=8.0",
        "composer/semver": "^3.4",
        "bitwasp/buffertools": "^0.5.7",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-gmp": "*",
        "ext-bcmath": "*",
        "paragonie/ecc": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    }
}
